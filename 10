void setup() {
  Serial.begin(9600);
  pinMode(18, OUTPUT);
}

void loop() {
  char val;

  if (Serial.available()) {
    val = Serial.read();

    if (val == '1')
      digitalWrite(18, HIGH);

    if (val == '0')
      digitalWrite(18, LOW);
  }
}
