a

void setup() {
  Serial.begin(9600);
  pinMode(35, INPUT);
}

void loop() {
  int val;
  val = digitalRead(35);

  Serial.println(val);

  if (val == 1)
    Serial.println("Key Pressed");
  else
    Serial.println("Key Released");
}

b
void setup() {
  Serial.begin(9600);
  pinMode(35, INPUT);
  pinMode(2, OUTPUT);
}

void loop() {
  int val;
  val = digitalRead(35);

  Serial.println(val);
  delay(500);

  if (val == 1) {
    Serial.println("LED is ON");
    digitalWrite(2, HIGH);
  }
  else {
    Serial.println("LED is OFF");
    digitalWrite(2, LOW);
  }
}
