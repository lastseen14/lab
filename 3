#include <NewPing.h>

#define TRIGGER_PIN 18
#define ECHO_PIN 19
#define MAX_DISTANCE 200

NewPing Sonar(TRIGGER_PIN, ECHO_PIN, MAX_DISTANCE);

void setup() {
  Serial.begin(9600);
  pinMode(14, OUTPUT);
}

void loop() {
  delay(1000);

  unsigned int us = Sonar.ping_in();

  Serial.print(us);
  Serial.println("cm");

  if (us < 6)
    digitalWrite(14, HIGH);
  else
    digitalWrite(14, LOW);
}
